{
  "name": "spocket",
  "displayName": "Corner",
  "description": "Real-time sync between VS Code workspace folders and Corner manifests",
  "version": "2.0.1",
  "publisher": "jadennation",
  "repository": {
    "url": "https://github.com/designerGenes/corner"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:spocket.openDailyFeature",
    "onCommand:spocket.newDailyFeature"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Corner",
      "properties": {
        "spocket.binaryPath": {
          "type": "string",
          "default": "corner",
          "description": "Path to the Corner binary"
        },
        "spocket.dailyFeatureSubpath": {
          "type": "string",
          "default": "dailies",
          "description": "Subfolder under FEATURES where new daily feature files are created"
        }
      }
    },
    "commands": [
      {
        "command": "spocket.openDailyFeature",
        "title": "Corner: Open Daily Feature"
      },
      {
        "command": "spocket.newDailyFeature",
        "title": "Corner: New Daily Feature File"
      }
    ],
    "keybindings": [
      {
        "command": "spocket.openDailyFeature",
        "key": "ctrl+alt+t",
        "mac": "ctrl+alt+t",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "spocket.newDailyFeature",
        "key": "ctrl+shift+alt+t",
        "mac": "ctrl+shift+alt+t",
        "when": "workspaceFolderCount > 0 && spocket.inTodaysFeature"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepackage": "npm run compile",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
