{
  "name": "left-pocket",
  "displayName": "left Pocket (left_pocket)",
  "description": "Real-time sync between VS Code workspace folders and left_pocket manifests",
  "version": "2.1.1",
  "publisher": "jadennation",
  "repository": {
    "url": "https://github.com/designerGenes/left_pocket"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:left_pocket.openDailyFeature",
    "onCommand:left_pocket.newDailyFeature"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "left_pocket",
      "properties": {
        "left_pocket.binaryPath": {
          "type": "string",
          "default": "left_pocket",
          "description": "Path to the left_pocket binary"
        },
        "left_pocket.dailyFeatureSubpath": {
          "type": "string",
          "default": "dailies",
          "description": "Subfolder under FEATURES where new daily feature files are created"
        }
      }
    },
    "commands": [
      {
        "command": "left_pocket.openDailyFeature",
        "title": "left_pocket: Open Daily Feature"
      },
      {
        "command": "left_pocket.newDailyFeature",
        "title": "left_pocket: New Daily Feature File"
      }
    ],
    "keybindings": [
      {
        "command": "left_pocket.openDailyFeature",
        "key": "ctrl+alt+t",
        "mac": "ctrl+alt+t",
        "when": "workspaceFolderCount > 0"
      },
      {
        "command": "left_pocket.newDailyFeature",
        "key": "ctrl+shift+alt+t",
        "mac": "ctrl+shift+alt+t",
        "when": "workspaceFolderCount > 0 && left_pocket.inTodaysFeature"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepackage": "npm run compile",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
